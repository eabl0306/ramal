{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["docs/**"],
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {},
    "packages/eslint-config": {
      "entry": ["rules/*.test.js"]
    },
    "packages/tsconfig": {},
    "tools/checks": {
      "entry": ["*.mjs"]
    },
    "packages/domain": {},
    "packages/i18n": {},
    "packages/ui": {},
    "packages/repo-view": {},
    "packages/bridge": {
      "ignore": ["src/generated/**"]
    },
    "packages/api-client": {
      "ignore": ["src/generated/**"]
    },
    "apps/web": {},
    "apps/desktop": {
      "entry": ["wdio/specs/**/*.e2e.ts"],
      "ignoreDependencies": ["@wdio/local-runner", "@wdio/tauri-service"]
    },
    "apps/vscode": {
      "entry": [
        "src/extension/app/extension.ts",
        "src/webview/app/entries/*.tsx",
        "scripts/*.mjs",
        "test/integration/**/*.test.ts"
      ],
      "ignoreDependencies": ["@vscode/test-electron"],
      "ignoreBinaries": ["pgrep"]
    }
  }
}
