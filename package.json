{
  "name": "git-rudder-monorepo",
  "version": "0.1.0",
  "license": "FSL-1.1-ALv2",
  "private": true,
  "type": "module",
  "description": "Monorepo de Git Rudder: cliente de Git con API en Rust, web, escritorio con Tauri y extension de VS Code.",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:file-size": "node tools/checks/file-size.mjs",
    "check:focused-tests": "node tools/checks/no-focused-tests.mjs",
    "check:todos": "node tools/checks/todo-without-ticket.mjs",
    "check:package-graph": "node tools/checks/package-graph.mjs",
    "check:limit-suppressions": "node tools/checks/no-limit-suppressions.mjs",
    "check:cargo-lints": "node tools/checks/cargo-lints.mjs",
    "check:eslint-configs": "node tools/checks/eslint-configs.mjs",
    "check:rust-test-modules": "node tools/checks/rust-test-modules.mjs",
    "check:toolchain-versions": "node tools/checks/toolchain-versions.mjs",
    "check:docker-context": "node tools/checks/docker-context.mjs",
    "check:docs-links": "node tools/checks/docs-links.mjs",
    "check:quality": "node tools/checks/file-size.mjs && node tools/checks/no-focused-tests.mjs && node tools/checks/todo-without-ticket.mjs && node tools/checks/package-graph.mjs && node tools/checks/no-limit-suppressions.mjs && node tools/checks/cargo-lints.mjs && node tools/checks/eslint-configs.mjs && node tools/checks/rust-test-modules.mjs && node tools/checks/toolchain-versions.mjs && node tools/checks/docker-context.mjs && node tools/checks/docs-links.mjs",
    "check:tools-test": "node --test \"tools/checks/*.test.mjs\" \"packages/eslint-config/*.test.js\" \"packages/eslint-config/rules/*.test.js\"",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "lint:css": "stylelint \"apps/**/*.css\" \"packages/**/*.css\" --allow-empty-input --max-warnings 0",
    "knip": "knip"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@git-rudder/eslint-config": "workspace:*",
    "eslint": "10.13.0",
    "knip": "6.41.0",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-declaration-strict-value": "1.12.1"
  }
}
