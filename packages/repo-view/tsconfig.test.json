// Tests de componentes (Testing Library sobre jsdom), helpers de test y la
// configuracion de Vitest, que corre en Node.
{
  "extends": "@ramal/tsconfig/react.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "./node_modules/.tmp/tsc/test",
    "tsBuildInfoFile": "./node_modules/.tmp/tsc/test.tsbuildinfo",
    "types": ["node"]
  },
  "references": [
    { "path": "./tsconfig.lib.json" },
    { "path": "../ui/tsconfig.lib.json" },
    { "path": "../i18n/tsconfig.lib.json" },
    { "path": "../bridge" }
  ],
  "include": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/test",
    "src/css-modules.d.ts",
    "vitest.config.ts"
  ]
}
