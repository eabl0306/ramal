{
  "name": "@git-rudder/eslint-config",
  "version": "0.1.0",
  "license": "FSL-1.1-ALv2",
  "private": true,
  "description": "Configuracion plana de ESLint compartida: TypeScript type-aware, limites de tamano y complejidad, React, Node, arquitectura y reglas propias de Git Rudder.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./base": "./base.js",
    "./quality": "./quality.js",
    "./react": "./react.js",
    "./node": "./node.js",
    "./boundaries": "./boundaries.js",
    "./tests": "./tests.js"
  },
  "files": [
    "index.js",
    "base.js",
    "quality.js",
    "react.js",
    "node.js",
    "boundaries.js",
    "tests.js",
    "rules/"
  ],
  "scripts": {
    "test": "node --test \"*.test.js\" \"rules/*.test.js\""
  },
  "dependencies": {
    "@eslint-react/eslint-plugin": "5.28.2",
    "@eslint/js": "10.0.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-sonarjs": "4.2.2",
    "globals": "17.13.0",
    "typescript-eslint": "8.72.0"
  },
  "devDependencies": {
    "eslint": "10.13.0",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "eslint": "^10.0.0",
    "typescript": ">=5.8.0 <6.1.0"
  }
}
