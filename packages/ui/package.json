{
  "name": "@ramal/ui",
  "version": "0.1.0",
  "license": "FSL-1.1-ALv2",
  "private": true,
  "description": "Tokens, temas, densidades, iconos, primitivas accesibles y el enlace React de @ramal/i18n.",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./src/themes/fonts.ts"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./icons/lucide": "./src/icons/lucide/index.ts",
    "./icons/codicons": "./src/icons/codicons/index.ts",
    "./themes/ramal.css": "./src/themes/ramal.css",
    "./themes/vscode.css": "./src/themes/vscode.css",
    "./themes/fonts": "./src/themes/fonts.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@ramal/i18n": "workspace:*",
    "@vscode/codicons": "0.0.45",
    "lucide-react": "1.49.0",
    "react-aria-components": "1.21.1"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@ramal/eslint-config": "workspace:*",
    "@ramal/tsconfig": "workspace:*",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "10.11.0",
    "jsdom": "30.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
