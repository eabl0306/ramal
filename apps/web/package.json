  "license": "FSL-1.1-ALv2",
  "private": true,
  "description": "Git Rudder Web: landing prerenderizada en castellano e ingles, entrar y crear cuenta, y el estado del servicio.",
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "preview": "node scripts/preview-server.mjs",
