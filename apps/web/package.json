    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@git-rudder/api-client": "workspace:*",
    "@git-rudder/domain": "workspace:*",
    "@git-rudder/i18n": "workspace:*",
