// Codigo de la web y sus tests de Vitest. Solo referencia los paquetes que
// architecture.md 5.2 le deja importar: importar otro rompe `tsc -b` con TS6307
// aunque ESLint no estuviera bien configurado.
{
  "extends": "@ramal/tsconfig/react.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsc/app.tsbuildinfo",
    "types": ["vite/client"]
  },
  "references": [
    { "path": "../../packages/domain/tsconfig.lib.json" },
    { "path": "../../packages/i18n/tsconfig.lib.json" },
    { "path": "../../packages/ui/tsconfig.lib.json" },
    { "path": "../../packages/api-client/tsconfig.lib.json" }
  ],
  "include": ["src"]
}
