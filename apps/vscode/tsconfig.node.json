// Lo que corre fuera del producto: la configuracion de Vite y Playwright, los e2e
// de Playwright (Node que maneja un navegador) y los tests de integracion, que
// corren con mocha dentro de un VS Code de verdad.
{
  "extends": "@ramal/tsconfig/base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "./node_modules/.tmp/tsc/node",
    "tsBuildInfoFile": "./node_modules/.tmp/tsc/node.tsbuildinfo",
    "lib": ["ES2023", "DOM"],
    "types": ["node", "mocha", "vscode"]
  },
  "references": [
    { "path": "./tsconfig.shared.json" },
    { "path": "./tsconfig.extension.json" },
    { "path": "../../packages/bridge" }
  ],
  "include": ["vite.config.ts", "playwright.config.ts", "e2e", "test/integration"]
}
