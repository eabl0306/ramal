// Extension host: Node con los tipos de VS Code y sin DOM. Un `window` o un
// `document` aqui no compila. Referencia lo que puede importar: los mensajes
// compartidos, @ramal/bridge y @ramal/i18n.
{
  "extends": "@ramal/tsconfig/node.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "./node_modules/.tmp/tsc/extension",
    "tsBuildInfoFile": "./node_modules/.tmp/tsc/extension.tsbuildinfo",
    "rootDir": "./src",
    "types": ["node", "vscode"]
  },
  "references": [
    { "path": "./tsconfig.shared.json" },
    { "path": "../../packages/bridge" },
    { "path": "../../packages/i18n/tsconfig.lib.json" }
  ],
  "include": ["src/extension"],
  "exclude": ["src/**/*.test.ts"]
}
