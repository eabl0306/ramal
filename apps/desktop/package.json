{
  "name": "@ramal/desktop",
  "version": "0.1.0",
  "license": "FSL-1.1-ALv2",
  "private": true,
  "description": "Ramal Desktop: frontend React del host de Tauri que pinta el grafo con @ramal/repo-view.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "e2e:native": "wdio run ./wdio.conf.ts",
    "tauri": "tauri"
  },
  "dependencies": {
    "@ramal/bridge": "workspace:*",
    "@ramal/i18n": "workspace:*",
    "@ramal/repo-view": "workspace:*",
    "@ramal/ui": "workspace:*",
    "@tanstack/react-query": "5.104.3",
    "@tauri-apps/api": "2.12.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@ramal/eslint-config": "workspace:*",
    "@ramal/tsconfig": "workspace:*",
    "@tauri-apps/cli": "2.12.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "@wdio/cli": "9.32.0",
    "@wdio/globals": "9.31.3",
    "@wdio/local-runner": "9.32.0",
    "@wdio/mocha-framework": "9.32.0",
    "@wdio/spec-reporter": "9.32.0",
    "@wdio/tauri-service": "1.5.0",
    "eslint": "10.13.0",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "webdriverio": "9.32.0"
  }
}
