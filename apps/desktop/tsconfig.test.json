// Tests de Vitest (Testing Library sobre jsdom) y sus ayudas. Incluye
// tauri.conf.json porque un test comprueba la CSP de produccion.
{
  "extends": "@ramal/tsconfig/react.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "./node_modules/.tmp/tsc/test",
    "tsBuildInfoFile": "./node_modules/.tmp/tsc/test.tsbuildinfo",
    "types": ["node", "vite/client"]
  },
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "../../packages/bridge" },
    { "path": "../../packages/i18n/tsconfig.lib.json" },
    { "path": "../../packages/ui/tsconfig.lib.json" },
    { "path": "../../packages/repo-view/tsconfig.lib.json" }
  ],
  "include": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/test", "src-tauri/tauri.conf.json"]
}
