# Copia a .env y ajusta. .env nunca se commitea.
#
# La API lee su configuracion del entorno con el prefijo GIT_RUDDER__ y `__` como
# separador de nivel (GIT_RUDDER__DATABASE__URL es database.url). Todo lo que aparece
# aqui tiene que tener un valor por defecto en el codigo, asi que este fichero es
# la lista de lo que se puede mover, no de lo que hace falta.
#
# `just` carga este fichero solo (dotenv-load), asi que las recetas ven los
# mismos valores que docker compose.

# --- Puertos de la pila (compose.yaml) ---
# IP en la que docker compose publica los puertos. Solo esta maquina por defecto;
# 0.0.0.0 los abre a toda la red, saltandose el cortafuegos.
GIT_RUDDER_BIND_IP=127.0.0.1

# --- Postgres (compose.yaml) ---
POSTGRES_USER=git_rudder
POSTGRES_PASSWORD=git_rudder
POSTGRES_DB=git_rudder
POSTGRES_PORT=5432

# --- API (Rust / Salvo) ---
# Solo esta maquina; el contenedor de compose pone 0.0.0.0 por su cuenta.
GIT_RUDDER__SERVER__HOST=127.0.0.1
GIT_RUDDER__SERVER__PORT=8080
# Swagger UI en /swagger-ui/. Por defecto apagado; en produccion se deja asi.
GIT_RUDDER__SERVER__SWAGGER_UI=true
GIT_RUDDER__DATABASE__URL=postgres://git_rudder:git_rudder@localhost:5432/git_rudder
GIT_RUDDER__DATABASE__MAX_CONNECTIONS=5
GIT_RUDDER__DATABASE__ACQUIRE_TIMEOUT_MS=3000
GIT_RUDDER__TELEMETRY__LOG_LEVEL=info
API_PORT=8080

# --- Autenticacion ---
# Comentadas a proposito: la configuracion de la API rechaza las claves que no
# conoce, y una variable que todavia no lee haria fallar el arranque. Se
# descomentan cuando exista el modulo que las usa.
#
# ACCESS_TOKEN_SECRET firma los tokens de sesion y TOKEN_ENCRYPTION_KEY cifra los
# tokens de los proveedores de Git guardados en Postgres. En produccion son
# obligatorios y salen de un gestor de secretos, nunca de este fichero.
# GIT_RUDDER__AUTH__ACCESS_TOKEN_SECRET=
# GIT_RUDDER__AUTH__TOKEN_ENCRYPTION_KEY=
# GIT_RUDDER__AUTH__GITHUB__CLIENT_ID=
# GIT_RUDDER__AUTH__GITHUB__CLIENT_SECRET=

# --- Correo de desarrollo (Mailpit, perfil full) ---
# Interfaz web en http://localhost:8025. La API le habla por SMTP en el 1025.
MAILPIT_WEB_PORT=8025
MAILPIT_SMTP_PORT=1025

# --- Web (React Router) ---
WEB_PORT=5173

# --- Gateway de nginx (perfil full) ---
# Sirve la web y la API bajo el mismo origen, que es lo que evita el problema de
# CORS en el navegador. Es la puerta por la que entran `just smoke` y los e2e de pila.
GATEWAY_PORT=8090
