{
  "name": "@ramal/checks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Comprobaciones de calidad comunes a todo el monorepo. Node puro, sin dependencias.",
  "bin": {
    "check-file-size": "./file-size.mjs",
    "check-focused-tests": "./no-focused-tests.mjs",
    "check-todos": "./todo-without-ticket.mjs",
    "check-package-graph": "./package-graph.mjs",
    "check-limit-suppressions": "./no-limit-suppressions.mjs",
    "check-cargo-lints": "./cargo-lints.mjs",
    "check-eslint-configs": "./eslint-configs.mjs",
    "check-rust-test-modules": "./rust-test-modules.mjs"
  },
  "scripts": {
    "test": "node --test \"*.test.mjs\""
  }
}
